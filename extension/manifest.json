{
  "manifest_version": 3,
  "name": "Svelte-JSONEditor P2P Swarm Relay",
  "version": "1.0.0",
  "description": "Background P2P WebRTC Swarm Relay for offline-first real-time workspace sync across groups.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Svelte-JSONEditor P2P Relay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "offscreen"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "p2p-swarm-relay@svelte-jsoneditor.local",
      "strict_min_version": "109.0"
    }
  }
}
